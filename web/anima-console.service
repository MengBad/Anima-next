[Unit]
Description=Anima Console (Web Management Panel)
After=network-online.target
Wants=network-online.target
After=anima.service

[Service]
Type=simple
# 以 root 运行以便读取 journal 与执行 systemctl restart anima
User=root
Group=root
WorkingDirectory=/opt/anima
Environment=ANIMA_CONFIG=/opt/anima/config.yaml
Environment=ANIMA_SERVICE=anima
Environment=ANIMA_CONSOLE_PORT=8080
Environment=ANIMA_CONSOLE_SSL_CERT=/etc/ssl/certs/anima-console.crt
Environment=ANIMA_CONSOLE_SSL_KEY=/etc/ssl/private/anima-console.key
Environment=ANIMA_CONSOLE_HTTPS_PORT=8443
# 控制台鉴权 token。安全规范：禁止在版本库写入真实值。
# token 唯一来源是 /opt/anima/web/.env（ANIMA_CONSOLE_TOKEN=<真实值>，已被 .gitignore 忽略，模板见 web/.env.example）。
# 注意：不得在此文件写 Environment=ANIMA_CONSOLE_TOKEN=... —— 它会覆盖 EnvironmentFile 的值，
# 导致 .env 的 token 失效。若 .env 缺失或仍为占位值，web/server.py 会在启动期 fail-fast 拒绝启动。
EnvironmentFile=-/opt/anima/web/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/anima/venv/bin/python -m web.server
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
