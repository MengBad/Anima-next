# Anima Console 环境变量示例（复制为 .env 或直接注入系统环境）
# 复制本文件为 .env 并填入真实值；.env 不得提交到仓库。

# 控制台访问令牌（必填，前端登录时使用）
ANIMA_CONSOLE_TOKEN=change-me-to-a-strong-random-token

# bot 项目根目录（默认：web/ 的上级目录）
# ANIMA_ROOT=/opt/anima

# 配置文件路径（默认：<根>/config.yaml）
# ANIMA_CONFIG=/opt/anima/config.yaml

# 监听端口
ANIMA_CONSOLE_PORT=8080

# 受管理的 bot systemd 服务名
ANIMA_SERVICE=anima

# 日志命令模板（{service} {n} 会被替换）
# ANIMA_LOG_CMD=journalctl -u {service} --no-pager -n {n} --output=short-iso

# CORS 允许的源（逗号分隔；留空则同源 + localhost）
# ANIMA_CONSOLE_CORS=http://localhost:8080,http://127.0.0.1:8080
